# LuckyTodo 飞牛 / Docker 可选环境变量
# 复制为 deploy/.env 后由 docker compose 读取

# AI 洞察（OpenAI 兼容接口）。也可用浏览器打开 /admin.html 配置。
AI_ENABLED=false
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat

# 定时任务间隔（毫秒），默认 12 小时
INSIGHT_INTERVAL_MS=43200000

# 客户端默认仅手机号+密码，不使用验证码登录。
# 下列 OTP/短信变量仅在调用服务端 OTP 接口时生效，可留空。
# LUCKYTODO_TEST_OTP=123456
# LUCKYTODO_SMS_WEBHOOK=https://sms.example.com/send

# 对象存储模式（S2）：local | s3-compatible（未完全接好时仍写本地镜像）
LUCKYTODO_OBJECT_STORE=local
