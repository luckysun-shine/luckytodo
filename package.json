{
  "name": "luckytodo",
  "version": "0.3.0",
  "private": true,
  "description": "家庭代办 LuckyTodo",
  "scripts": {
    "api": "LUCKYTODO_DATA=./apps/api/data node apps/api/src/index.js",
    "web": "python3 -m http.server 5173 --bind 0.0.0.0 --directory apps/web",
    "start": "LUCKYTODO_DATA=./apps/api/data node apps/api/src/index.js",
    "test:api": "node --test apps/api/test/*.test.js",
    "cap:sync": "npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:add:ios": "npx cap add ios",
    "build:web": "npm --prefix apps/web run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/local-notifications": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  }
}
