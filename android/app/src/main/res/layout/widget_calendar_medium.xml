<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9月"
                android:textColor="#8E8E93"
                android:textSize="12sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今天"
                android:textColor="#1C1C1E"
                android:textSize="16sp"
                android:textStyle="bold"/>
        </LinearLayout>
        <TextView
            android:id="@+id/widget_add"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_add_btn"
            android:gravity="center"
            android:text="+"
            android:textColor="#07323C"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/week_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/week_d0"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/widget_day_idle"
                android:gravity="center"
                android:textColor="#1C1C1E"
                android:textSize="12sp"
                android:text="1"/>
            <ImageView
                android:id="@+id/week_m0"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/widget_dot"
                android:contentDescription="@null"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/week_d1"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/widget_day_idle"
                android:gravity="center"
                android:textColor="#1C1C1E"
                android:textSize="12sp"
                android:text="1"/>
            <ImageView
                android:id="@+id/week_m1"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/widget_dot"
                android:contentDescription="@null"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/week_d2"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/widget_day_idle"
                android:gravity="center"
                android:textColor="#1C1C1E"
                android:textSize="12sp"
                android:text="1"/>
            <ImageView
                android:id="@+id/week_m2"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/widget_dot"
                android:contentDescription="@null"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/week_d3"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/widget_day_idle"
                android:gravity="center"
                android:textColor="#1C1C1E"
                android:textSize="12sp"
                android:text="1"/>
            <ImageView
                android:id="@+id/week_m3"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/widget_dot"
                android:contentDescription="@null"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/week_d4"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/widget_day_idle"
                android:gravity="center"
                android:textColor="#1C1C1E"
                android:textSize="12sp"
                android:text="1"/>
            <ImageView
                android:id="@+id/week_m4"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/widget_dot"
                android:contentDescription="@null"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/week_d5"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/widget_day_idle"
                android:gravity="center"
                android:textColor="#1C1C1E"
                android:textSize="12sp"
                android:text="1"/>
            <ImageView
                android:id="@+id/week_m5"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/widget_dot"
                android:contentDescription="@null"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/week_d6"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/widget_day_idle"
                android:gravity="center"
                android:textColor="#1C1C1E"
                android:textSize="12sp"
                android:text="1"/>
            <ImageView
                android:id="@+id/week_m6"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/widget_dot"
                android:contentDescription="@null"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="今天还没有安排"
        android:textColor="#8E8E93"
        android:textSize="12sp"
        android:visibility="gone"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

    <LinearLayout
        android:id="@+id/cal_row_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/cal_time_0"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:textColor="#8E8E93"
            android:textSize="11sp"
            android:text="全天"/>
        <TextView
            android:id="@+id/cal_title_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#1C1C1E"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text="事项"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/cal_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/cal_time_1"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:textColor="#8E8E93"
            android:textSize="11sp"
            android:text="全天"/>
        <TextView
            android:id="@+id/cal_title_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#1C1C1E"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text="事项"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/cal_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/cal_time_2"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:textColor="#8E8E93"
            android:textSize="11sp"
            android:text="全天"/>
        <TextView
            android:id="@+id/cal_title_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#1C1C1E"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text="事项"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/cal_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/cal_time_3"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:textColor="#8E8E93"
            android:textSize="11sp"
            android:text="全天"/>
        <TextView
            android:id="@+id/cal_title_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#1C1C1E"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text="事项"/>
    </LinearLayout>
    </LinearLayout>
</LinearLayout>
